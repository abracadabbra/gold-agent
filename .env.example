# GoldAgent 环境变量配置示例
# 复制此文件为 .env 并填入实际配置

# ======================
# LLM 配置
# ======================

# OpenAI API 密钥（或兼容端点的密钥）
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI API 基础 URL（支持 OpenAI 兼容端点）
OPENAI_BASE_URL=https://api.openai.com/v1

# 各 Agent 使用的模型
LLM_MODEL_BULL=gpt-4.1
LLM_MODEL_BEAR=claude-sonnet-4-20250514
LLM_MODEL_AUDITOR=gpt-4.1-mini
LLM_MODEL_ARBITRATOR=gpt-4.1

# ======================
# 数据源配置
# ======================

# FRED API 密钥（用于获取宏观经济数据）
# 申请地址: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# ======================
# 数据库配置
# ======================

# PostgreSQL 连接 URL
DATABASE_URL=postgresql+asyncpg://gold:gold@localhost:5432/gold_agent

# Redis 连接 URL
REDIS_URL=redis://localhost:6379/0

# ======================
# 缓存配置
# ======================

# 数据缓存目录
DATA_CACHE_DIR=./data/cache

# Parquet 文件目录
PARQUET_DIR=./data/parquet

# ======================
# 应用配置
# ======================

# 应用端口
APP_PORT=8000

# 应用主机
APP_HOST=0.0.0.0

# 调试模式
DEBUG=false

# 日志级别
LOG_LEVEL=INFO

# ======================
# 定时任务配置
# ======================

# 每日分析任务时间（24小时格式）
DAILY_ANALYSIS_HOUR=9
DAILY_ANALYSIS_MINUTE=0

# 自动辩论间隔（小时）
AUTO_DEBATE_INTERVAL_HOURS=24